# Configuración del backend de AssistX
# Copiá este archivo como `.env` y completá los valores reales.

# Puerto donde corre la API (el frontend proxea /api a este puerto)
PORT=5000

# Conexión a la base de datos MySQL / MariaDB
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=assistx_db

# Secreto para firmar los JWT. Generá uno propio y privado, por ejemplo:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
